# Copy to .env.local and fill in. Everything here is optional —
# the site runs without any of it, it just logs enquiries instead of emailing them.

# Public origin, used for canonical URLs, hreflang, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.privateofficeconsulting.fr

# --- Contact form delivery (https://resend.com) ---
# Without RESEND_API_KEY every enquiry is written to the server log instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@privateofficeconsulting.fr
# Must be a domain verified in Resend once you go live.
CONTACT_FROM_EMAIL=Private Office Consulting <contact@privateofficeconsulting.fr>

# --- Analytics (https://plausible.io) ---
# Leave empty and no analytics script is loaded at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only needed when self-hosting Plausible.
NEXT_PUBLIC_PLAUSIBLE_HOST=
